# =============================================================================
# VARIABLES DE ENTORNO — RESIDENCIAS DAN TORRE A
# =============================================================================
# Si estas variables están vacías, el portal funciona en Modo Local de prueba.
# Al configurar tu proyecto en Supabase (gratis), copia los valores aquí:

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nombre del bucket para PDFs y Fotos de evidencia
NEXT_PUBLIC_STORAGE_BUCKET=condominio-files
